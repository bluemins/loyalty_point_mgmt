{
  "name": "loyalty-point-mgmt",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant QR loyalty platform",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "expire": "node src/jobs/expirePoints.js",
    "test": "node --test",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.js",
    "test:demo": "node --test tests/e2e/demo.e2e.js",
    "admin:create": "node src/cli/createAdmin.js",
    "tenant:create": "node src/cli/createTenant.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.11.5",
    "redis": "^4.6.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
