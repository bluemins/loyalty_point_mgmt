PORT=3000
NODE_ENV=development
APP_NAME=loyalty-demo

DATABASE_URL=postgresql://app_user:app_password@localhost:5432/loyalty_dev
REDIS_URL=redis://:redis_password@localhost:6379

SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_DAYS=30

# Admin panel: session length and login lockout
ADMIN_SESSION_TTL_HOURS=12
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_MAX_FAILURES_PER_IP=20
DEMO_TENANT_SLUG=demo
DEMO_TENANT_NAME=Demo Works

# Leave empty for mock OTP mode (fixed OTP 000000, no SMS sent)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=LOYALTY
MSG91_TEMPLATE_ID=LOYALTY_OTP
